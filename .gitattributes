# Normalize text line endings without changing character encodings.
* text=auto

# Source, configuration, and documentation
*.cs text eol=lf
*.shader text eol=lf
*.compute text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Unity YAML assets (keep project serialization in text mode)
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.anim text eol=lf
# .asset files can be YAML or binary; retain automatic detection.
*.asset text=auto

# Media, fonts, and compiled WebGL files must remain byte-exact.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.psd binary
*.psb binary
*.tga binary
*.exr binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.fbx binary
*.dll binary
*.data binary
*.wasm binary
*.unityweb binary
*.gz binary
*.br binary
*.zip binary
